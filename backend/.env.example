# ==========================================
# Royal Libas by Tanya - Backend Environment Config
# NOTE: Use placeholders ONLY. Never commit real keys or secrets.
# ==========================================

# Database (PostgreSQL on Neon)
DATABASE_URL=YOUR_NEON_DATABASE_URL_HERE

# Cashfree Payment Gateway
CASHFREE_CLIENT_ID=YOUR_CASHFREE_APP_ID_HERE
CASHFREE_CLIENT_SECRET=YOUR_CASHFREE_SECRET_KEY_HERE
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2023-08-01
BACKEND_PUBLIC_URL=

# Cloudinary Media Storage (Photos & Videos)
# Precedence: Explicit separate keys (CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET)
# take precedence over CLOUDINARY_URL if both are provided.
# You may configure either the 3 individual variables OR configure CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET_HERE
# CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# Admin Auth & JWT
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Shiprocket Fulfillment API (Admin Triggered Only)
# API user created in Shiprocket panel: Settings -> API -> Create API User (must be different from main account login)
SHIPROCKET_API_EMAIL=YOUR_SHIPROCKET_API_USER_EMAIL_HERE
SHIPROCKET_API_PASSWORD=YOUR_SHIPROCKET_API_USER_PASSWORD_HERE
SHIPROCKET_PICKUP_LOCATION=Primary

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
